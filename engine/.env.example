# ----------------------------------------------------------------------
# Agent-chain path (new — see config.yaml `agents:` section)
# ----------------------------------------------------------------------

# SearXNG endpoint. Defaults to localhost:8888 (see infra/searxng/).
# SEARXNG_URL=http://localhost:8888

# Brave Search API — fallback when SearXNG is down or upstream engines
# are all suspended. Free tier: 2K queries/month, 1 query/sec.
# Register at https://brave.com/search/api/
# BRAVE_API_KEY=BSA...

# Optional: include local ollama in the chain (also needs ollama daemon).
# OLLAMA_MODEL=qwen2.5:7b


# ----------------------------------------------------------------------
# Legacy SDK path (researcher.py — deprecated, kept for old configs)
# ----------------------------------------------------------------------

# Google Gemini (FREE) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Anthropic Claude (~$0.50-1.00/day) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Perplexity (~$0.10/day) - https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...
